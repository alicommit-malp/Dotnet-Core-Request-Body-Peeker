<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageId>Request.Body.Peeker</PackageId>
    <Version>2.0.0</Version>
    <Authors>Ali Alp</Authors>
    <Title>HttpRequest Body Peeker for ASP.NET Core</Title>
    <Description>Read the ASP.NET Core HttpRequest body in middleware or filters without consuming it. Async-only, System.Text.Json by default, chunked-request safe, trimming and AOT compatible via the JsonTypeInfo&lt;T&gt; overload and the string/bytes methods (the reflection-based overload is annotated).</Description>
    <Copyright>Copyright (c) Ali Alp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/alicommit-malp/Dotnet-Core-Request-Body-Peeker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alicommit-malp/Dotnet-Core-Request-Body-Peeker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aspnetcore;httprequest;request-body;middleware;filter;peek;buffering;json</PackageTags>
    <PackageReleaseNotes>2.0.0: async-only API, System.Text.Json default, chunked/no-Content-Length support, CancellationToken, charset detection, FrameworkReference instead of legacy package, multi-target net8/net9/net10, trimming/AOT safe via the JsonTypeInfo&lt;T&gt; overload and the string/bytes methods (reflection overload annotated). Breaking: sync PeekBody removed, ISerializer replaced by IBodySerializer, Newtonsoft dependency removed.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
